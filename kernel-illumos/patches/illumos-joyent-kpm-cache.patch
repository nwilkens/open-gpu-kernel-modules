Date: Mon, 2 Nov 2026 14:29:09 -0300
Subject: [PATCH] x86 hat: preserve existing PTE bits in KPM cache transitions

---
 .../hat_kpm_cache/test_source_contract.py     | 36 ++++++++++
 usr/src/uts/i86pc/vm/hat_i86.c                | 66 +++++++++++++++++++
 usr/src/uts/i86pc/vm/hat_i86.h                |  2 +
 3 files changed, 104 insertions(+)
 create mode 100644 usr/src/test/os-tests/tests/hat_kpm_cache/test_source_contract.py

diff --git a/usr/src/test/os-tests/tests/hat_kpm_cache/test_source_contract.py b/usr/src/test/os-tests/tests/hat_kpm_cache/test_source_contract.py
new file mode 100644
index 0000000000..21524a6999
--- /dev/null
+++ b/usr/src/test/os-tests/tests/hat_kpm_cache/test_source_contract.py
@@ -0,0 +1,36 @@
+#!/usr/bin/env python3
+#
+# CDDL HEADER START
