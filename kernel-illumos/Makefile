###########################################################################
# Makefile for the NVIDIA illumos kernel modules.
#
# Builds the illumos kernel interface layer and links it with the
# OS-agnostic nv-kernel.o and nv-modeset-kernel.o objects that the
# top-level Makefile builds from src/.  nvidia_uvm is built from the
# kernel-open/nvidia-uvm sources.
#
#   gmake                       build all modules
#   gmake install DESTDIR=...   install into $(DESTDIR)/kernel/drv/amd64
###########################################################################

NV_ROOT         ?= $(abspath ..)
OUTPUTDIR       ?= _out/SunOS_x86_64

.DEFAULT_GOAL   := all
include $(NV_ROOT)/version.mk

CC              ?= gcc
LD              := /usr/bin/ld
CTFCONVERT      ?= $(shell command -v ctfconvert 2>/dev/null)
INSTALL         ?= /usr/bin/ginstall
DESTDIR         ?=

NV_KERNEL_O     ?= $(NV_ROOT)/src/nvidia/_out/SunOS_x86_64/nv-kernel.o
NV_MODESET_O    ?= $(NV_ROOT)/src/nvidia-modeset/_out/SunOS_x86_64/nv-modeset-kernel.o

COMMON_INC      := $(NV_ROOT)/kernel-open/common/inc
KOPEN_NVIDIA    := $(NV_ROOT)/kernel-open/nvidia

# Flags matching the illumos amd64 kernel build (usr/src/uts/Makefile.uts):
# kernel code model, no red zone or SIMD, retpolines against the kernel's
# __x86_indirect_thunk_* and frame layout that DTrace fbt can instrument.
KERNEL_CFLAGS   := -m64 -D_KERNEL -D_SYSCALL32 -D_SYSCALL32_IMPL -D_ELF64 \
                   -D_DDI_STRICT -Dsun -D__sun -D__SVR4 \
                   -ffreestanding -fno-builtin -nodefaultlibs \
                   -mcmodel=kernel -mno-red-zone -mno-mmx -mno-sse \
                   -msave-args -fno-asynchronous-unwind-tables \
                   -fno-shrink-wrap -fno-jump-tables \
                   -mindirect-branch=thunk-extern -mindirect-branch-register \
                   -fno-strict-aliasing -fno-omit-frame-pointer \
                   -O2 -gdwarf-4 -std=gnu11

WARN_CFLAGS     := -Wall -Wno-unused-parameter -Wno-sign-compare \
                   -Wno-missing-field-initializers -Wno-unused-function \
                   -Wno-unknown-pragmas -Werror=implicit-function-declaration

NV_DEFINES      := -DNVRM -DNV_KERNEL_INTERFACE_LAYER \
                   -DNV_VERSION_STRING=\"$(NVIDIA_VERSION)\" \
                   -DNVIDIA_UNDEF_LEGACY_BIT_MACROS

# Kernel headers come from an illumos source tree matching the running
# platform, the way in-gate drivers build.  Headers generated by the gate
# build (sys/priv_names.h and friends) are taken from /usr/include.
ILLUMOS_SRC     ?= /opt/illumos-joyent-hdrs
GCC_INC         := $(shell $(CC) -print-file-name=include)
KERNEL_INC      := -nostdinc \
                   -I$(ILLUMOS_SRC)/usr/src/uts/i86pc \
                   -I$(ILLUMOS_SRC)/usr/src/uts/intel \
                   -I$(ILLUMOS_SRC)/usr/src/uts/common \
                   -isystem $(GCC_INC) \
                   -idirafter /usr/include

CFLAGS_BASE     := $(KERNEL_CFLAGS) $(WARN_CFLAGS) $(NV_DEFINES) \
                   -I$(COMMON_INC) $(KERNEL_INC) $(EXTRA_CFLAGS)

###########################################################################
# nvidia
###########################################################################

NVIDIA_SRCS     := \
    nvidia/nvidia_acpi.c \
    nvidia/nvidia_acpi_display.c \
    nvidia/nvidia_caps.c \
    nvidia/nvidia_cb.c \
    nvidia/nvidia_crypto.c \
    nvidia/nvidia_crypto_hash.c \
    nvidia/nvidia_ddi.c \
    nvidia/nvidia_dma.c \
    nvidia/nvidia_fw.c \
    nvidia/nvidia_gpu.c \
    nvidia/nvidia_i2c_interface.c \
    nvidia/nvidia_intr.c \
    nvidia/nvidia_ioctl.c \
    nvidia/nvidia_mem.c \
    nvidia/nvidia_misc.c \
    nvidia/nvidia_mmap.c \
    nvidia/nvidia_modeset_interface.c \
    nvidia/nvidia_nvlink.c \
    nvidia/nvidia_nvswitch.c \
    nvidia/nvidia_nvswitch_ioctl.c \
    nvidia/nvidia_nvswitch_os.c \
    nvidia/nvidia_os.c \
    nvidia/nvidia_os_platform.c \
    nvidia/nvidia_os_sync.c \
    nvidia/nvidia_pci.c \
    nvidia/nvidia_pm.c \
    nvidia/nvidia_registry.c \
    nvidia/nvidia_umem.c

# OS-neutral sources shared with the Linux build.
NVIDIA_KOPEN_SRCS := \
    nv_uvm_interface.c

NVIDIA_OBJS     := $(patsubst %.c,$(OUTPUTDIR)/%.o,$(NVIDIA_SRCS)) \
                   $(patsubst %.c,$(OUTPUTDIR)/nvidia/kopen/%.o,$(NVIDIA_KOPEN_SRCS))
NVIDIA_CFLAGS   := $(CFLAGS_BASE) -Invidia -Icommon/inc -I$(KOPEN_NVIDIA) \
                   -DNV_UVM_ENABLE -DLIBSPDM_CONFIG=\"nvspdm_rmconfig.h\"
NVIDIA_DEPS     := -Nmisc/gfx_private -Nmisc/acpica -Nmisc/pcie \
                   -Nmisc/sha2 -Nmisc/kcf

NVIDIA_HDRS     := $(wildcard nvidia/*.h common/inc/*.h)

$(OUTPUTDIR)/nvidia/%.o: nvidia/%.c $(NVIDIA_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia/kopen/%.o: $(KOPEN_NVIDIA)/%.c $(NVIDIA_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia.kmod: $(NVIDIA_OBJS) $(NV_KERNEL_O)
	$(LD) -ztype=kmod $(NVIDIA_DEPS) -o $@ $^
	$(if $(CTFCONVERT),$(CTFCONVERT) -l $(NVIDIA_VERSION) $@)

###########################################################################
# nvidia_modeset
###########################################################################

NVIDIA_MODESET_SRCS := \
    nvidia-modeset/nvidia_modeset_illumos.c \
    nvidia-modeset/nvkms_config.c \
    nvidia-modeset/nvkms_os.c \
    nvidia-modeset/nvkms_q.c

NVIDIA_MODESET_OBJS   := $(patsubst %.c,$(OUTPUTDIR)/%.o,$(NVIDIA_MODESET_SRCS))
NVIDIA_MODESET_CFLAGS := $(CFLAGS_BASE) -Invidia-modeset \
                         -I$(NV_ROOT)/kernel-open/nvidia-modeset \
                         -UDEBUG -U_DEBUG -DNDEBUG -DNV_BUILD_MODULE_INSTANCES=0
NVIDIA_MODESET_DEPS   := -Ndrv/nvidia

$(OUTPUTDIR)/nvidia-modeset/%.o: nvidia-modeset/%.c \
    nvidia-modeset/nvidia_modeset_illumos.h
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_MODESET_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia_modeset.kmod: $(NVIDIA_MODESET_OBJS) $(NV_MODESET_O)
	$(LD) -ztype=kmod $(NVIDIA_MODESET_DEPS) -o $@ $^
	$(if $(CTFCONVERT),$(CTFCONVERT) -l $(NVIDIA_VERSION) $@)

###########################################################################
# nvidia_i2c
###########################################################################

NVIDIA_I2C_SRCS   := nvidia-i2c/nvidia_i2c.c
NVIDIA_I2C_OBJS   := $(patsubst %.c,$(OUTPUTDIR)/%.o,$(NVIDIA_I2C_SRCS))
NVIDIA_I2C_CFLAGS := $(CFLAGS_BASE) -Icommon/inc
NVIDIA_I2C_DEPS   := -Ndrv/nvidia -Ndrv/i2cnex

$(OUTPUTDIR)/nvidia-i2c/%.o: nvidia-i2c/%.c common/inc/nv-illumos-i2c.h
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_I2C_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia_i2c.kmod: $(NVIDIA_I2C_OBJS)
	$(LD) -ztype=kmod $(NVIDIA_I2C_DEPS) -o $@ $^
	$(if $(CTFCONVERT),$(CTFCONVERT) -l $(NVIDIA_VERSION) $@)

###########################################################################
# nvidia_uvm
###########################################################################

KOPEN_UVM       := $(NV_ROOT)/kernel-open/nvidia-uvm

include $(KOPEN_UVM)/nvidia-uvm-sources.Kbuild

# The tests are left out, and four sources have illumos replacements.
NVIDIA_UVM_KOPEN_SRCS := $(filter-out %_test.c uvm_test.c uvm_test_rng.c \
    uvm_test_file.c nv-kthread-q-selftest.c nv-kthread-q.c \
    uvm_ats_faults.c uvm_populate_pageable.c, \
    $(notdir $(NVIDIA_UVM_SOURCES)))

# Sources that build against the Linux compatibility headers, like the
# kernel-open ones, and sources that use illumos headers only.
NVIDIA_UVM_KPI_SRCS := \
    nvidia-uvm/nv_kthread_q_illumos.c \
    nvidia-uvm/uvm_ats_faults_stub.c \
    nvidia-uvm/uvm_illumos_bitmap.c \
    nvidia-uvm/uvm_illumos_rbtree.c \
    nvidia-uvm/uvm_populate_illumos.c \
    nvidia-uvm/uvm_test_stubs.c

NVIDIA_UVM_SRCS := \
    nvidia-uvm/uvm_illumos.c \
    nvidia-uvm/uvm_illumos_kpi.c \
    nvidia-uvm/uvm_illumos_page.c \
    nvidia-uvm/uvm_seg.c

NVIDIA_UVM_OBJS := $(patsubst %.c,$(OUTPUTDIR)/%.o,$(NVIDIA_UVM_SRCS)) \
                   $(patsubst nvidia-uvm/%.c,$(OUTPUTDIR)/nvidia-uvm/kpi/%.o,$(NVIDIA_UVM_KPI_SRCS)) \
                   $(patsubst %.c,$(OUTPUTDIR)/nvidia-uvm/kopen/%.o,$(NVIDIA_UVM_KOPEN_SRCS))

# The shadow tree in nvidia-uvm/lkpi supplies nv-linux.h, conftest.h and the
# <linux/*.h> headers, so it comes before kernel-open/common/inc.
NVIDIA_UVM_CFLAGS := $(KERNEL_CFLAGS) $(WARN_CFLAGS) \
                     -DNVRM -DNV_KERNEL_INTERFACE_LAYER -DNV_UVM_ENABLE \
                     -DNV_VERSION_STRING=\"$(NVIDIA_VERSION)\" \
                     -DNVIDIA_UVM_ENABLED -DNVIDIA_UNDEF_LEGACY_BIT_MACROS \
                     -DNV_BUILD_MODULE_INSTANCES=0 \
                     -Invidia-uvm/lkpi -I$(COMMON_INC) -I$(KOPEN_UVM) \
                     -Icommon/inc $(KERNEL_INC) $(EXTRA_CFLAGS)
NVIDIA_UVM_DEPS := -Ndrv/nvidia

# The compatibility header goes first, so that every UVM header sees the
# renamed identifiers (file in particular) whatever it includes itself.
# Kbuild also turns off -Wunused-but-set-variable.
NVIDIA_UVM_KOPEN_CFLAGS := $(NVIDIA_UVM_CFLAGS) -Wno-unused-but-set-variable \
                           -include uvm_illumos_kpi.h

NVIDIA_UVM_HDRS := $(wildcard nvidia-uvm/*.h nvidia-uvm/lkpi/*.h \
                   nvidia-uvm/lkpi/*/*.h common/inc/*.h)

$(OUTPUTDIR)/nvidia-uvm/%.o: nvidia-uvm/%.c $(NVIDIA_UVM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_UVM_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia-uvm/kpi/%.o: nvidia-uvm/%.c $(NVIDIA_UVM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_UVM_KOPEN_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia-uvm/kopen/%.o: $(KOPEN_UVM)/%.c $(NVIDIA_UVM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(NVIDIA_UVM_KOPEN_CFLAGS) -c $< -o $@

$(OUTPUTDIR)/nvidia_uvm.kmod: $(NVIDIA_UVM_OBJS)
	$(LD) -ztype=kmod $(NVIDIA_UVM_DEPS) -o $@ $^
	$(if $(CTFCONVERT),$(CTFCONVERT) -l $(NVIDIA_VERSION) $@)

###########################################################################

MODULES         := $(OUTPUTDIR)/nvidia.kmod $(OUTPUTDIR)/nvidia_modeset.kmod \
                   $(OUTPUTDIR)/nvidia_i2c.kmod \
                   $(OUTPUTDIR)/nvidia_uvm.kmod

# PCI aliases for the GPUs listed as supported in the top-level README, and
# the NVSwitch management endpoints (nvswitch_lr10_device_ids and the first
# eight nvswitch_ls10_device_ids in src/common/nvswitch/kernel/nvswitch.c).
ALIASES         := $(OUTPUTDIR)/nvidia.aliases
NVSWITCH_IDS    := 1ae8 1af0 1af1 1af2 1af3 1af4 1af5 1af6 1af7 1af8 1af9 \
                   1afa 1afb 1afc 1afd 1afe 1aff \
                   22a0 22a1 22a2 22a3 22a4 22a5 22a6 22a7

$(ALIASES): $(NV_ROOT)/README.md
	@mkdir -p $(dir $@)
	( awk -F'|' 'NF == 4 && $$3 ~ /^ [0-9A-F][0-9A-F][0-9A-F][0-9A-F]( |$$)/ \
	    { split($$3, id, " "); print "\"pciex10de," tolower(id[1]) "\"" }' $<; \
	  for id in $(NVSWITCH_IDS); do echo "\"pciex10de,$$id\""; done ) | \
	    sort -u > $@

.PHONY: all objs clean install
all: $(MODULES) $(ALIASES)

objs: $(NVIDIA_OBJS) $(NVIDIA_MODESET_OBJS) $(NVIDIA_I2C_OBJS) $(NVIDIA_UVM_OBJS)

clean:
	rm -rf _out

install: all
	$(INSTALL) -d $(DESTDIR)/kernel/drv/amd64
	$(INSTALL) -m 0755 $(OUTPUTDIR)/nvidia.kmod $(DESTDIR)/kernel/drv/amd64/nvidia
	$(INSTALL) -m 0644 nvidia/nvidia.conf $(DESTDIR)/kernel/drv/nvidia.conf
	$(INSTALL) -m 0755 $(OUTPUTDIR)/nvidia_modeset.kmod \
	    $(DESTDIR)/kernel/drv/amd64/nvidia_modeset
	$(INSTALL) -m 0644 nvidia-modeset/nvidia_modeset.conf \
	    $(DESTDIR)/kernel/drv/nvidia_modeset.conf
	$(INSTALL) -m 0755 $(OUTPUTDIR)/nvidia_i2c.kmod \
	    $(DESTDIR)/kernel/drv/amd64/nvidia_i2c
	$(INSTALL) -m 0644 nvidia-i2c/nvidia_i2c.conf \
	    $(DESTDIR)/kernel/drv/nvidia_i2c.conf
	$(INSTALL) -m 0755 $(OUTPUTDIR)/nvidia_uvm.kmod \
	    $(DESTDIR)/kernel/drv/amd64/nvidia_uvm
	$(INSTALL) -m 0644 nvidia-uvm/nvidia_uvm.conf \
	    $(DESTDIR)/kernel/drv/nvidia_uvm.conf
